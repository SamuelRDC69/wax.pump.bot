# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Multiple destinations format examples:
# @channelname (public channel)
# -100123456789 (private channel)
# @groupname:123 (group with topic, where 123 is topic ID)
# -100123456789:456 (private group with topic)
# Combine multiple with commas: @channel1,@group1:123,-100123456789:456
TELEGRAM_DESTINATIONS=@yourchannel,-100123456789,@group1:123

# API Keys
SUBSTREAMS_API_TOKEN=your_substreams_api_token_here
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Network Configuration (testnet or mainnet)
NETWORK=testnet
